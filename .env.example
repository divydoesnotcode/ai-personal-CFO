APP_NAME=AI Personal CFO
APP_VERSION=0.1.0

ENVIRONMENT=development
DEBUG=true

# Host port 5433 maps to Postgres 5432 inside Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/personal_cfo

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Optional. Leave empty until LLM features are wired up.
LLM_API_KEY=
LLM_MODEL=

# Generate a unique value of at least 32 characters.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-key
